{
  "$id": "https://github.com/Astraive/loza/spec/cortex/schemas/json/cortex-reconstruct-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOZA Cortex Reconstruct Response",
  "type": "object",
  "required": [
    "incident_id",
    "timestamp",
    "causal_chain",
    "related_services",
    "similar_incidents",
    "symptoms",
    "suggested_actions",
    "confidence",
    "explain"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "causal_chain": {
      "type": ["array", "null"],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/CausalEvent"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "related_services": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "similar_incidents": {
      "type": ["array", "null"],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/SimilarIncident"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "symptoms": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/$defs/Symptom"
      }
    },
    "suggested_actions": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/$defs/RemediationAction"
      }
    },
    "partial": {
      "type": "boolean"
    },
    "warnings": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "explain": {
      "type": "string"
    },
    "explain_report": {
      "oneOf": [
        {
          "$ref": "#/$defs/ExplainReport"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "CausalEvent": {
      "type": "object",
      "required": [
        "event_id",
        "timestamp",
        "kind",
        "service",
        "description",
        "attributes",
        "causal_edge",
        "signal_density"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "attributes": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "causal_edge": {
          "type": "string"
        },
        "signal_density": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "RemediationAction": {
      "type": "object",
      "required": [
        "action",
        "description",
        "success_rate",
        "avg_time_to_resolve_seconds",
        "priority"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "success_rate": {
          "type": "number"
        },
        "avg_time_to_resolve_seconds": {
          "type": "integer"
        },
        "priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "SimilarIncident": {
      "type": "object",
      "required": [
        "incident_id",
        "timestamp",
        "similarity",
        "shape",
        "resolution",
        "resolution_time_seconds",
        "success_rate"
      ],
      "properties": {
        "incident_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "similarity": {
          "type": "number"
        },
        "shape": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "resolution_time_seconds": {
          "type": "integer"
        },
        "success_rate": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "Symptom": {
      "type": "object",
      "required": ["type", "service", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "latency_spike",
            "error_rate",
            "timeout",
            "memory_leak",
            "cpu_spike",
            "deployment_fail"
          ]
        },
        "service": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "threshold": {
          "type": "number"
        },
        "observed": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExplainReport": {
      "type": "object",
      "required": [
        "narrative",
        "confidence_breakdown",
        "key_findings",
        "data_gaps",
        "alternative_hypotheses"
      ],
      "properties": {
        "narrative": {
          "type": "string"
        },
        "confidence_breakdown": {
          "$ref": "#/$defs/ConfidenceBreakdown"
        },
        "key_findings": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "data_gaps": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "alternative_hypotheses": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ConfidenceBreakdown": {
      "type": "object",
      "required": [
        "causal_chain_strength",
        "symptom_coverage",
        "historical_match",
        "remediation_confidence"
      ],
      "properties": {
        "causal_chain_strength": {
          "type": "number"
        },
        "symptom_coverage": {
          "type": "number"
        },
        "historical_match": {
          "type": "number"
        },
        "remediation_confidence": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
